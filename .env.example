# ── IT Master content engine (Pull API) ───────────────────────────────────
# Engine origin. Local: http://127.0.0.1:8088 — Prod: the public engine URL.
ITMASTER_API_URL=http://127.0.0.1:8088
# This site's TargetSite slug, registered in the engine (owner: dev.codedpro).
PUBLISH_SITE=karjoo-ai
# Per-site pull key issued by the engine (POST /v1/publish/sites). Server-only.
PUBLISH_PULL_KEY=karjoo_pull_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional HMAC secret for the publish→revalidate push webhook.
# PUBLISH_PUSH_SECRET=
# Public site URL (canonical/OG/sitemap base).
NEXT_PUBLIC_SITE_URL=https://karjoo.ai

# ── Karjoo control plane: Postgres ─────────────────────────────────────────
# Control-plane database (separate from the IT Master content engine).
# Matches docker-compose.yml (`npm run db:up`): db=karjoo user=karjoo pass=karjoo.
# Required to boot anything that touches the DB; validated in src/lib/env.ts.
DATABASE_URL=postgres://karjoo:karjoo@localhost:5432/karjoo

# ── Karjoo AI: 1xai gateway (OpenAI-compatible) ────────────────────────────
# ALL model calls (match scoring, cover letters, screening answers) go through
# this gateway — never hard-wire a provider URL/key. These are OPTIONAL at boot
# (the app starts without them) but REQUIRED the moment any AI feature runs;
# requireOneXai() in src/lib/env.ts throws a clear error naming the missing var.
# Base URL of the 1xai gateway (e.g. https://gateway.1xai.example/v1).
ONEXAI_BASE_URL=
# Secret API key for the gateway. Server-only — never expose to the client.
ONEXAI_API_KEY=
# Model id to request through the gateway (e.g. gpt-4o-mini or a 1xai alias).
ONEXAI_MODEL=

# ── Karjoo control plane: internal API shared secret ───────────────────────
# Shared-secret guard for the /api/internal/* routes (sent as the
# `X-Internal-Secret` header). OPTIONAL at boot, but the internal routes
# fail closed (503) until it is set — requireInternalSecret() in src/lib/env.ts
# throws when it is missing. Set a long random value in real environments.
INTERNAL_API_SECRET=

# ── Karjoo auth: token/OTP pepper ──────────────────────────────────────────
# Server-only secret mixed into every OTP/session-token hash (HMAC pepper).
# NEVER stored in the DB, NEVER sent to the client — only used to compute hashes.
# OPTIONAL at boot (landing/blog start without it) but REQUIRED the moment any
# OTP or session is issued/verified: requireAuthPepper() in src/lib/env.ts throws
# (fail-closed) when missing, so weak/empty-pepper hashes can never be produced.
# Use a long random value, min 16 chars, e.g. `openssl rand -hex 32`.
AUTH_TOKEN_PEPPER=

# ── Karjoo auth: SMS provider (phone-OTP delivery) ─────────────────────────
# ALL optional. If NONE is set, sendOtpSms() logs the OTP to the console in dev
# (instead of sending) and returns a "dev_mode" marker — so the app boots and
# works without any real SMS credentials. Kavenegar (an Iranian provider) is
# preferred; otherwise the generic SMS_API_KEY/SMS_SENDER pair is used.
# Kavenegar API key (https://kavenegar.com). Server-only.
KAVENEGAR_API_KEY=
# Kavenegar verify-lookup template name for OTP delivery (optional).
KAVENEGAR_TEMPLATE=
# Generic SMS provider key (e.g. SMS.ir) — used only if KAVENEGAR_API_KEY unset.
SMS_API_KEY=
# Sender line/id for the generic provider (optional).
SMS_SENDER=
