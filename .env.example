# ── IT Master content engine (Pull API) ───────────────────────────────────
# Engine origin. Local: http://127.0.0.1:8088 — Prod: the public engine URL.
ITMASTER_API_URL=http://127.0.0.1:8088
# This site's TargetSite slug, registered in the engine (owner: dev.codedpro).
PUBLISH_SITE=karjoo-ai
# Per-site pull key issued by the engine (POST /v1/publish/sites). Server-only.
PUBLISH_PULL_KEY=karjoo_pull_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional HMAC secret for the publish→revalidate push webhook.
# PUBLISH_PUSH_SECRET=
# Public site URL (canonical/OG/sitemap base).
NEXT_PUBLIC_SITE_URL=https://karjoo.ai

# ── Karjoo control plane: Postgres ─────────────────────────────────────────
# Control-plane database (separate from the IT Master content engine).
# Matches docker-compose.yml (`npm run db:up`): db=karjoo user=karjoo pass=karjoo.
# Required to boot anything that touches the DB; validated in src/lib/env.ts.
DATABASE_URL=postgres://karjoo:karjoo@localhost:5432/karjoo

# ── Karjoo AI: 1xai gateway (OpenAI-compatible) ────────────────────────────
# ALL model calls (match scoring, cover letters, screening answers) go through
# this gateway — never hard-wire a provider URL/key. These are OPTIONAL at boot
# (the app starts without them) but REQUIRED the moment any AI feature runs;
# requireOneXai() in src/lib/env.ts throws a clear error naming the missing var.
# Base URL of the 1xai gateway (e.g. https://gateway.1xai.example/v1).
ONEXAI_BASE_URL=
# Secret API key for the gateway. Server-only — never expose to the client.
ONEXAI_API_KEY=
# Model id to request through the gateway (e.g. gpt-4o-mini or a 1xai alias).
ONEXAI_MODEL=

# ── Karjoo control plane: internal API shared secret ───────────────────────
# Shared-secret guard for the /api/internal/* routes (sent as the
# `X-Internal-Secret` header). OPTIONAL at boot, but the internal routes
# fail closed (503) until it is set — requireInternalSecret() in src/lib/env.ts
# throws when it is missing. Set a long random value in real environments.
INTERNAL_API_SECRET=

# ── Karjoo auth: session-token pepper ──────────────────────────────────────
# Server-only secret mixed into every session-token hash (HMAC pepper).
# NEVER stored in the DB, NEVER sent to the client — only used to compute hashes.
# OPTIONAL at boot (landing/blog start without it) but REQUIRED the moment any
# session is issued/verified: requireAuthPepper() in src/lib/env.ts throws
# (fail-closed) when missing, so weak/empty-pepper hashes can never be produced.
# Use a long random value, min 16 chars, e.g. `openssl rand -hex 32`.
AUTH_TOKEN_PEPPER=

# ── Karjoo auth: Google Sign-In (OAuth2 Authorization-Code) ─────────────────
# Login is Google-only. These are SERVER-ONLY (never exposed to the client) and
# must NEVER be logged. OPTIONAL at boot (landing/blog start without them) but
# REQUIRED the moment the OAuth flow starts / a code is exchanged:
# requireGoogleOAuth() in src/lib/env.ts throws (fail-closed) when either is unset.
# Create the OAuth client at https://console.cloud.google.com (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional redirect_uri override. If unset it is derived as
#   <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
# This value MUST match EXACTLY one of the "Authorized redirect URIs" on the
# Google OAuth client. Production authorized URI:
#   https://karjooai.itmaster.uk/api/auth/callback/google
GOOGLE_REDIRECT_URI=

# ── Karjoo auth: SMS provider (LEGACY — unused after Google migration) ──────
# DEPRECATED. Phone-OTP login was removed; identity is now the Google account.
# These vars are kept only so pre-existing deployments don't error on unknown
# keys; nothing in the app reads them for login anymore. Leave blank.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
SMS_API_KEY=
SMS_SENDER=

# ── Karjoo billing: pay-as-you-go AI margin ────────────────────────────────
# Karjoo's profit margin (percent) over the 1xai upstream price on every PAID
# AI call: costToman = upstreamCostToman × (1 + KARJOO_AI_MARGIN_PCT/100).
# OPTIONAL — defaults to 20 (resolveMarginPct() in src/lib/env.ts). Integer ≥ 0.
KARJOO_AI_MARGIN_PCT=20

# ── Karjoo guardrails: global AI budget cap (WF3 — protects real upstream cost) ─
# When this calendar month's app-wide UPSTREAM AI cost reaches the cap, Karjoo
# enters AI MAINTENANCE MODE: every PAID AI call is blocked (503 + Persian msg);
# NON-AI features (apply, PDF text, import, dashboard) keep working.
#   cap (Toman) = KARJOO_AI_MONTHLY_BUDGET_USD × KARJOO_USD_TO_TOMAN
# Both OPTIONAL — default 30 USD × 70000 = 2,100,000 Toman/month.
KARJOO_AI_MONTHLY_BUDGET_USD=30
KARJOO_USD_TO_TOMAN=70000

# ── Karjoo guardrails: per-call hard limits (WF3 — no loops / runaway cost) ─────
# Default max output tokens applied to every AI call when the caller didn't set
# one, plus a request timeout (AbortController) on the gateway fetch. The gateway
# never retries in a loop. Both OPTIONAL — defaults 1200 tokens / 60000 ms.
KARJOO_AI_MAX_OUTPUT_TOKENS=1200
KARJOO_AI_TIMEOUT_MS=60000

# ── Karjoo: model catalog seeding (one-time, after migrate) ─────────────────
# The AI model catalog (ai_model_catalog) is created by migrations but NOT
# populated by them. After `npm run db:migrate`, run `npm run db:seed` once to
# fill the catalog (live prices from {ONEXAI_BASE_URL}/pricing if reachable,
# else a built-in seed). Without it the model picker is empty and the first
# paid AI call fails (no model price). Idempotent — safe to re-run.
# Full dev setup: npm run db:up → npm run db:migrate → npm run db:seed

# ── Karjoo billing: monthly AI-credit grants (WF3 — cron seam) ─────────────
# Paid plans (pro/max/maxplus) receive a monthly AI credit (plans.ts
# monthlyCreditToman). The grant is IDEMPOTENT per (user, YYYY-MM), so re-runs
# in the same month never double-credit. A REAL scheduler comes later; until
# then, an external monthly cron must trigger one of these (NO in-app scheduler):
#   • Script:  tsx --conditions=react-server src/scripts/grant-monthly.ts
#   • HTTP:    POST /api/internal/grant-credits  (header X-Internal-Secret)
# Example crontab (00:10 on the 1st of each month):
#   10 0 1 * *  cd /path/to/karjoo-ai && tsx --conditions=react-server \
#                 src/scripts/grant-monthly.ts >> /var/log/karjoo-grant.log 2>&1
# The HTTP route is guarded by INTERNAL_API_SECRET above (fail-closed without it).

# ── Karjoo: encrypted session vault (Max/Max+ auto-apply — §10 track C) ─────
# AES-256-GCM key for encrypting the user's OWN session blob in the vault
# (session_blobs), replayed by Iranian worker nodes for that SAME user only.
# A 32-byte key as base64 OR hex (64 hex chars). OPTIONAL: when UNSET,
# POST /api/session/refresh returns a clear "vault not configured" error and
# stores NOTHING (never plaintext — fail-closed). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KARJOO_VAULT_KEY=

# ── Karjoo: auto-apply scheduling (ADVISORY for the MV3 extension — §10) ────
# These only ADVISE the extension's chrome.alarms drain cadence + politeness
# jitter (returned in settings); the server itself does nothing with them.
# All OPTIONAL — defaults: 15 min alarm, 2000–8000 ms jitter.
KARJOO_AUTO_APPLY_ALARM_MINUTES=15
KARJOO_AUTO_APPLY_JITTER_MS_MIN=2000
KARJOO_AUTO_APPLY_JITTER_MS_MAX=8000

# ── Karjoo: worker fleet (Max/Max+ — §10, rules 1 & 4) ──────────────────────
# Shared ONE-TIME enrollment secret that a worker node presents to enroll. The
# server verifies it (constant-time) and issues a per-node credential (only the
# credential's hash is stored). OPTIONAL: when UNSET, enrollment is CLOSED and
# enrollNode is refused (503 — fail-closed; no node can enroll without it).
# Min 16 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
KARJOO_FLEET_ENROLLMENT_TOKEN=
# Advisory path the worker node runs on an 'update' command (pull+restart,
# deployment-agnostic). The server only REPORTS this in the command payload; it
# never runs anything. OPTIONAL — default ./update.sh
KARJOO_FLEET_UPDATE_SCRIPT=./update.sh
