{
  "name": "karjoo-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Karjoo (کارجو) — MV3 browser extension: user-present, user-approved assisted apply for Iranian job boards.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
